<%- include('partials/header', { title: 'Sylo — Bot Personalizer' }) %>

<h1 class="page-title">Bot Personalizer</h1>
<p class="muted">Set the bot's activity. It is bot-wide — it applies in every server<% if (bot) { %>
  (currently <strong><%= bot.tag %></strong>)<% } %>.</p>

<% if (typeof m !== 'undefined' && m) { %>
  <div class="banner banner-flash <%= ok ? 'ok' : 'bad' %>"><%= m %></div>
<% } %>

<% if (!bot) { %>
  <section class="card"><p class="muted">The bot is not connected right now. Reload once it is online.</p></section>
<% } else { %>

<section class="card">
  <h2>Identity</h2>
  <div class="bp-identity">
    <div class="bp-avatar">
      <img src="<%= bot.avatar %>" alt="bot avatar" />
    </div>
    <div class="stack" style="flex:1;gap:8px">
      <strong><%= bot.username %></strong>
      <p class="muted small">Fluxer doesn't let bots change their own profile. Change the name, avatar and banner in
        the bot's application settings in Fluxer.</p>
    </div>
  </div>
</section>

<% } %>

<section class="card">
  <h2>Presence / activity</h2>
  <p class="muted small">
    What shows under the bot's name in Fluxer. <code>{servers}</code> and <code>{members}</code>
    are replaced with live counts and refreshed every 10 minutes.
  </p>

  <form method="POST" action="/settings/presence" class="stack u-mw-lg">
    <label>Online status</label>
    <select name="status">
      <% presenceStatuses.forEach(function (s) { %>
        <option value="<%= s %>" <%= s === presence.status ? 'selected' : '' %>>
          <%= ({ online: 'Online', idle: 'Idle', dnd: 'Do Not Disturb', invisible: 'Invisible' })[s] || s %>
        </option>
      <% }) %>
    </select>

    <label>Activity type</label>
    <select name="type">
      <% presenceTypes.forEach(function (t) { %>
        <option value="<%= t %>" <%= t === presence.type ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
    <p class="muted small">"Custom" shows the text as-is; the others prefix it with Playing / Listening to / Watching / Competing in.</p>

    <label>Text</label>
    <input type="text" name="text" maxlength="128" value="<%= presence.text %>" placeholder="e.g. over {servers} servers" />

    <div class="u-mt-3"><button type="submit">Save presence</button></div>
  </form>
</section>

<%- include('partials/footer') %>
